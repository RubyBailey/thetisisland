---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import visitorGuide from "../data/visitor-guide.yaml";

const page = await getEntry("pages", "communications");
if (!page) {
  throw new Error("Communications page content not found.");
}
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-primary mb-4">{page.data.title}</h1>
    {page.data.subtitle && (
      <p class="text-text-muted mb-10">{page.data.subtitle}</p>
    )}

    <div class="prose max-w-none text-text">
      <Content />
      {visitorGuide.document && (
        <p>
          <a
            href={visitorGuide.document}
            target="_blank"
            rel="noopener noreferrer"
          >Download the current Thetis Island Visitors' Guide</a>.
        </p>
      )}
    </div>
  </section>
</BaseLayout>
