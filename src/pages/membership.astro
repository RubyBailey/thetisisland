---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TallyThankYouRedirect from "../components/TallyThankYouRedirect.astro";

const page = await getEntry("special-pages", "membership");
const { Content } = await render(page);

---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-primary mb-4">{page.data.title}</h1>
    <p class="text-text-muted mb-10">Join the Thetis Island Residents &amp; Ratepayers Association and help shape our community.</p>

    <div class="prose max-w-none text-text">
      <Content />
    </div>

    <div class="mt-10">
      <iframe
        data-tally-form-id="2jAQx9"
        data-thank-you-url="/thank-you/membership/"
        data-tally-src="https://tally.so/embed/2jAQx9?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
        loading="lazy"
        width="100%"
        height="100"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="2027 TIRRA Membership Application / Renewal Form"
        class="block w-full border-0"
      ></iframe>

      <p class="mt-4 text-sm text-text-muted">
        Applications are submitted through Tally. If the form does not load,
        <a href="https://tally.so/r/2jAQx9" target="_blank" rel="noopener noreferrer" class="text-accent underline">open the membership form in a new tab</a>
        or email <a href="mailto:tirracommunications@thetisisland.net" class="text-accent underline">tirracommunications@thetisisland.net</a>.
      </p>
    </div>
  </section>

  <script is:inline>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>
  <TallyThankYouRedirect />
</BaseLayout>
