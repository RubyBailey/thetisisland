---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const documents = (await getCollection("tirra-documents"))
  .filter((document) => document.data.published)
  .sort((a, b) => b.data.document_date.getTime() - a.data.document_date.getTime());

const categories = [
  { value: "governance", label: "Governance" },
  { value: "reports", label: "Reports" },
  { value: "minutes", label: "Meeting Minutes" },
  { value: "forms", label: "Forms" },
  { value: "correspondence", label: "Correspondence" },
];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-CA", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<BaseLayout
  title="TIRRA Documents"
  description="TIRRA governance documents, reports, meeting minutes, forms and correspondence."
>
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-3xl font-bold text-primary mb-3">TIRRA Documents</h1>
    <p class="text-text-muted mb-10">
      Documents published by the Thetis Island Residents &amp; Ratepayers Association (TIRRA).
    </p>

    <div class="space-y-12">
      {categories.map((category) => {
        const categoryDocuments = documents.filter(
          (document) => document.data.category === category.value,
        );

        return (
          <section aria-labelledby={`tirra-${category.value}`}>
            <h2
              id={`tirra-${category.value}`}
              class="text-2xl font-bold text-primary border-b border-primary/20 pb-2 mb-5"
            >
              {category.label}
            </h2>

            {categoryDocuments.length === 0 ? (
              <p class="text-text-muted italic">No documents are currently published in this category.</p>
            ) : (
              <div class="divide-y divide-black/10 border-y border-black/10">
                {categoryDocuments.map((document) => (
                  <div class="flex flex-col gap-1 py-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                    <a
                      href={document.data.document_file}
                      class="font-medium text-accent hover:underline"
                    >
                      {document.data.title}
                    </a>
                    <span class="shrink-0 text-sm text-text-muted">
                      {formatDate(document.data.document_date)}
                    </span>
                  </div>
                ))}
              </div>
            )}
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>
