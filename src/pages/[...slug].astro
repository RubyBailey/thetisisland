---
/**
 * Catch-all route for standard (CMS-created) pages.
 * Special pages (home, ferry, membership) and
 * structural pages (community) have dedicated .astro files.
 * Emergency is edited under Pages but retains its fire-rating template.
 * that take precedence over this route.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TallyThankYouRedirect from "../components/TallyThankYouRedirect.astro";
import visitorGuide from "../data/visitor-guide.yaml";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.filter((page) => page.id !== "emergency").map((page) => ({
      params: { slug: page.id },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-primary mb-4">{page.data.title}</h1>
    {page.data.subtitle && (
      <p class={`text-text-muted ${page.id === "visitors" ? "mb-4" : "mb-10"}`}>{page.data.subtitle}</p>
    )}

    {page.id === "visitors" && visitorGuide.document && (
      <p class="mb-10">
        <a
          href={visitorGuide.document}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary underline hover:no-underline"
        >Download the current Thetis Island Visitors' Guide</a>.
      </p>
    )}

    <div class:list={["prose max-w-none text-text", { "services-content": page.id === "services" }]}>
      <Content />
    </div>
    {page.id === "contact" && (
      <section class="mt-10" aria-labelledby="contact-form-heading">
        <h2 id="contact-form-heading">Contact Form</h2>
        <iframe
          data-tally-form-id="8NL7A5"
          data-thank-you-url="/thank-you/contact/"
          src="https://tally.so/embed/8NL7A5?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
          loading="lazy"
          width="100%"
          height="717"
          frameborder="0"
          title="Contact TIRRA"
          class="block w-full border-0"
        ></iframe>
        <p class="mt-4 text-sm text-text-muted">
          If the form does not load,
          <a href="https://tally.so/r/8NL7A5" target="_blank" rel="noopener noreferrer" class="text-accent underline">open the contact form in a new tab</a>.
        </p>
        <script is:inline async src="https://tally.so/widgets/embed.js"></script>
      </section>
    )}
  </section>
  {page.id === "contact" && <TallyThankYouRedirect />}
</BaseLayout>
