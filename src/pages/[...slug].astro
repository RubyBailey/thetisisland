---
/**
 * Catch-all route for standard (CMS-created) pages.
 * Special pages (home, ferry, emergency, membership) and
 * structural pages (services, community) have dedicated .astro files
 * that take precedence over this route.
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import visitorGuide from "../data/visitor-guide.yaml";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-primary mb-4">{page.data.title}</h1>
    {page.data.subtitle && (
      <p class={`text-text-muted ${page.id === "visitors" ? "mb-4" : "mb-10"}`}>{page.data.subtitle}</p>
    )}

    {page.id === "visitors" && visitorGuide.document && (
      <p class="mb-10">
        <a
          href={visitorGuide.document}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary underline hover:no-underline"
        >Download the current Thetis Island Visitors' Guide</a>.
      </p>
    )}

    <div class="prose max-w-none text-text">
      <Content />
    </div>
  </section>
</BaseLayout>
