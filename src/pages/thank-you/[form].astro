---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [
    { params: { form: "contact" }, props: {
      heading: "Thank you for getting in touch",
      message: "Your message has been received. Someone from TIRRA will get back to you.",
    } },
    { params: { form: "membership" }, props: {
      heading: "Thank you for submitting your membership form",
      message: "Your membership or renewal form has been received. Thank you for supporting TIRRA. If you have not yet paid your dues, please follow the payment instructions provided on the form.",
    } },
  ];
}

const { heading, message } = Astro.props;
---

<BaseLayout title="Thank You" description="Your submission has been received.">
  <section class="mx-auto max-w-4xl px-4 py-20 text-center">
    <h1 class="text-3xl font-bold text-primary mb-4">{heading}</h1>
    <p class="text-text mb-6">{message}</p>
    <a href="/" class="text-accent font-medium hover:underline">&larr; Back to home</a>
  </section>
</BaseLayout>
